{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "アプリのメインウィンドウに付与する権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:app:allow-set-app-theme",
    "dialog:allow-open"
  ]
}
