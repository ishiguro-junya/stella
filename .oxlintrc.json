{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "rules": {
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error"
  },
  "plugins": ["import", "jsx-a11y", "oxc", "react", "typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "src-tauri/gen/**",
    "src-tauri/target/**",
    "target/**"
  ],
  "overrides": [
    {
      "files": ["*.config.ts", "scripts/**/*.mts", "tests/e2e/**/*.ts"],
      "env": {
        "browser": false,
        "node": true
      }
    },
    {
      "files": ["src/**/*.{test,spec}.{ts,tsx}"],
      "env": {
        "vitest": true
      }
    }
  ]
}
