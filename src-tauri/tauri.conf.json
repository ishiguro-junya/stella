{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stella",
  "version": "1.0.0-alpha.1",
  "identifier": "com.emuni.stella",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "beforeBuildCommand": "pnpm exec tsc -b && pnpm exec vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stella",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../node_modules/@pierre/diffs/LICENSE.md": "licenses/pierre-diffs-LICENSE.md",
      "../node_modules/@tauri-apps/plugin-dialog/LICENSE.spdx": "licenses/tauri-plugin-dialog-LICENSE.spdx",
      "../node_modules/lucide-react/LICENSE": "licenses/lucide-react-LICENSE",
      "../node_modules/react-is/LICENSE": "licenses/react-is-LICENSE",
      "../node_modules/recharts/LICENSE": "licenses/recharts-LICENSE"
    },
    "macOS": {
      "minimumSystemVersion": "26.0"
    }
  }
}
