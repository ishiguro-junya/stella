{
  "$schema": "./node_modules/markdownlint-cli2/markdownlint-cli2-config-schema.json",
  "customRules": [
    "./.markdownlint-rules/sentence-per-line.mts",
    "./.markdownlint-rules/paragraph-line-end-spaces.mts",
  ],
  "globs": ["**/*.md"],
  "gitignore": true,
  "ignores": ["app/native/target/**", "coverage/**", "dist/**", "node_modules/**", "target/**"],
  "config": {
    "default": true,
    "MD009": {
      "br_spaces": 2,
    },
    "MD013": false,
    "MD033": {
      "allowed_elements": ["details", "summary", "kbd", "h1", "p", "img", "br"],
    },
    "sentence-per-line": true,
    "paragraph-line-end-spaces": true,
  },
}
